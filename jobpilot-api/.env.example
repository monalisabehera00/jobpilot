PORT=5000
CLIENT_URL=http://localhost:4200

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=jobpilot

# At least 32 random characters. Never commit your real .env file.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Disposable database recreated by `npm test` (defaults to jobpilot_test)
TEST_DB_NAME=jobpilot_test

# AI match analysis: "anthropic" (Claude) or "mock" (offline keyword matching, no key needed)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Defaults are tuned for claude-opus-5-5
LLM_MODEL=claude-opus-5-5
# Total time allowed for one analysis, including automatic retries
LLM_TIMEOUT_MS=90000
# How many times the SDK retries rate limits, overloads and network errors
LLM_MAX_RETRIES=2

# Follow-up reminder emails (node-cron + Nodemailer)
REMINDERS_ENABLED=true
# Cron expression: minute hour day month weekday (default: every day at 08:00)
REMINDER_CRON=0 8 * * *
# IANA time zone for the schedule and "today", e.g. Asia/Kolkata (blank = server time zone)
REMINDER_TIMEZONE=
# "log" prints emails to the console; "smtp" sends real email
MAIL_TRANSPORT=log
MAIL_FROM=JobPilot <no-reply@jobpilot.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
